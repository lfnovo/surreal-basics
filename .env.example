# surreal-basics configuration — copy to .env and adjust.
# All variables are optional; the defaults shown match the library defaults.

# --- Option A: single URL (authoritative when set) ---------------------------
# Scheme picks the mode: ws/wss, http/https, mem/memory, file/surrealkv.
# SURREAL_URL=ws://localhost:8000/rpc
# SURREAL_URL=wss://tenant.region.surreal.cloud
# SURREAL_URL=mem://
# SURREAL_URL=file://./surreal.db

# --- Option B: discrete variables --------------------------------------------
SURREAL_HOST=localhost
SURREAL_PORT=8000
SURREAL_MODE=ws            # ws | http | memory | embedded
SURREAL_TLS=false          # true -> wss/https (and :443 default when no port set)
SURREAL_PATH=./surreal.db  # embedded mode only

# --- Auth & target -----------------------------------------------------------
SURREAL_USER=root
SURREAL_PASS=root          # alias: SURREAL_PASSWORD
SURREAL_NS=test            # alias: SURREAL_NAMESPACE
SURREAL_DB=test            # alias: SURREAL_DATABASE

# --- Connection behaviour ----------------------------------------------------
SURREAL_PERSISTENT=true    # reuse a singleton connection (3-6x faster on ws)

# --- Test suite only ---------------------------------------------------------
# The integration suite starts SurrealDB via docker compose on this host/port.
# TEST_SURREAL_HOST=localhost
# TEST_SURREAL_PORT=8000
# Set to 0 to skip docker management and use an already-running instance.
# SBL_TEST_DOCKER=1
